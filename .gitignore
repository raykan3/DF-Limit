# Only the paper (LaTeX/), the programs (public/) and the web demo (demo/) are tracked
/*
!/.gitignore
!/README.md
!/LaTeX/
!/public/
!/demo/

# LaTeX build files
*.aux
*.log
*.blg
*.out
*.toc
*.synctex
*.synctex.gz
*.fls
*.fdb_latexmk
*.spl
*.bbl
# but the validation logs are part of the record
!/public/validation/*.log
!/public/validation/tratio_legacy/*.log

# MATLAB/Octave scratch
*.asv
octave-workspace
!/julia/
!/c/
!/.github/
# built products of the Julia and C code
*.o
*.mex*
*.dylib
*.so
*.dll
c/dfl_test_prim
c/dfl_test_single
c/dfl_test_gen
c/dfl_test_mom
c/dfl_test_dbl
c/dfl_probe
c/dfl_test_fixed
c/dfl_test_vmath
